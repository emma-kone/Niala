# Niala — variables d'environnement (voir docs/ENVIRONNEMENT.md). Ne mettez JAMAIS de vraie valeur ici :
# copiez ce fichier en .env (ignoré par Git) et renseignez-le.

DATABASE_URL=
DIRECT_URL=
# La connexion Google se configure dans Supabase (Authentication > Providers), aucune variable supplémentaire ici.
AUTH_SECRET=                      # 32 caractères minimum : openssl rand -hex 32

NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=        # serveur uniquement — stockage des fichiers
SUPABASE_STORAGE_BUCKET=documents

# IA — Google Gemini (fournisseur principal). Clé lue uniquement côté serveur.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_DAILY_CALL_LIMIT=300

# Repli facultatif, utilisé seulement si GEMINI_API_KEY est absente
ANTHROPIC_API_KEY=

# Back-office : domaine dédié (ex. admin.niala.app). Vide = back-office sous /admin du même domaine. Voir docs/ADMIN.md.
ADMIN_HOST=

# Adresse SECRÈTE du back-office (24 caractères minimum, aléatoire : node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))").
# Le back-office s'ouvre via https://<domaine>/<ADMIN_PATH> ; sans elle, il est FERMÉ en production.
ADMIN_PATH=

# Code d'accès devant la connexion (hachage uniquement) : node scripts/admin-access-code.mjs
# Avec lui, /<ADMIN_PATH> affiche d'abord une page de code (5 essais ratés par IP et 15 min, puis blocage).
ADMIN_ACCESS_HASH=

# Mot de passe oublie : adresse publique utilisee dans les liens, et envoi des e-mails par Resend (facultatif).
# Sans RESEND_API_KEY/EMAIL_FROM, la demande arrive a l equipe Niala qui cree le lien depuis le back-office.
APP_URL=
RESEND_API_KEY=
EMAIL_FROM=

# Sécurité (voir docs/SECURITE.md). Plafond de requêtes par adresse IP et par tranche de 10 secondes (400 par défaut).
FLOOD_MAX_PER_10S=
