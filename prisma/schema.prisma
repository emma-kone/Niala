generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────── Utilisateurs & réglages ───────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  googleSub    String?  @unique // identifiant Google lié à ce compte (connexion Google sur un compte inscrit par mot de passe)
  name         String?
  sessionVersion Int    @default(0) // incrémenté pour fermer toutes les sessions ouvertes
  adminRole    String? // SUPER_ADMIN | ADMIN | SUPPORT | ANALYST ; null = compte étudiant ordinaire (voir server/admin/rbac.ts)
  accountStatus String  @default("ACTIVE") // ACTIVE | SUSPENDED | DISABLED
  statusReason String? // motif interne de la dernière suspension ou désactivation
  statusChangedAt DateTime?
  actorKey     String?   @unique // pseudonyme d'analyse (HMAC) : relie les statistiques d'usage au compte, tant que celui-ci existe
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  settings        UserSettings?
  profile         StudentProfile?
  tutorMessages   AttemptTutorMessage[]
  subjects        Subject[]
  documents       Document[]
  exercises       LegacyExercise[]
  sessions        Session[]
  conceptStats    ConceptStat[]
  recommendations StudyRecommendation[]
  aiLogs          AIUsageLog[]

  // ── V2 ──
  folders          Folder[]
  docVersions      DocumentVersion[]
  docChunks        DocumentChunk[]
  docAnalyses      DocumentAnalysis[]
  courseSections   CourseSection[]
  concepts         Concept[]
  conceptSources   ConceptSource[]
  conceptRelations ConceptRelation[]
  notes            Note[]
  noteLinks        NoteLink[]
  mindMaps         MindMap[]
  mindMapNodes     MindMapNode[]
  mindMapEdges     MindMapEdge[]
  mindMapRevisions MindMapRevision[]
  studyExercises   Exercise[]
  verificationRuns VerificationRun[]
  scheduleEvents   ScheduleEvent[]
  scheduleImports  ScheduleImport[]
  scheduleBreaks   ScheduleBreak[]
  academicTasks    AcademicTask[]
  studySessions    StudySession[]
  questions        Question[]
  attempts         ExerciseAttempt[]
  answers          Answer[]
  diagnoses        ErrorDiagnosis[]
  masteries        ConceptMastery[]
  activities       LearningActivity[]
  learningRecs     LearningRecommendation[]
  labWorkspaces    LabWorkspace[]
  labRuns          LabRun[]
  conversations    Conversation[]
  chatMessages     ConversationMessage[]
  supportRequests  SupportRequest[]
  notifications    UserNotification[]
}

model UserSettings {
  id            String  @id @default(cuid())
  userId        String  @unique
  theme         String  @default("system") // light | dark | system
  scheduleWeekSwap Boolean @default(false) // inverse la convention semaine A / semaine B
  agendaPrefs   Json? // préférences de travail, rappels et heures de tranquillité
  defaultMode   String  @default("apprentissage")
  maxUploadMB   Int     @default(20)
  hintsEnabled  Boolean @default(true)
  aiModel       String  @default("claude-sonnet-5-5")
  exerciseLang  String  @default("fr")
  retentionDays Int     @default(0) // 0 = conservation illimitée
  textSize         String  @default("normal") // normal | large
  correctionPref   String  @default("final") // immediate | final : valeur proposée à la création d'un exercice
  explanationLevel String  @default("standard") // simple | standard | detailed
  notifyProgress   Boolean @default(true)
  notifyRevision   Boolean @default(true)
  notifyActivities Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Informations personnelles et académiques. Sans ligne ou sans catégorie : compte créé avant l'inscription détaillée, ou par Google.
model StudentProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  category    String? // ESATIC | OTHER_SCHOOL | TESTER
  institution String?
  fieldCode   String? // code de la filière ESATIC (référentiel src/config/academic.ts) ; null ailleurs
  field       String? // intitulé de la filière ou spécialité
  className   String? // classe saisie librement (ex. « DASI 3 »)
  level       String? // BTS1 | BTS2 | L1 | L2 | L3 | M1 | M2 | AUTRE
  levelOther  String? // niveau précisé par l'étudiant quand level = AUTRE
  situation   String?
  usageReason String?
  avatar      String? // photo réduite côté navigateur (data:image/…) ; jamais la photo Google
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────── Organisation documentaire ───────────────────────────

model Subject {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String   @default("#8b5cf6")
  icon      String? // identifiant d'icône (voir domain/subject-icon.ts) ; null tant qu'elle n'a pas été attribuée
  iconAuto  Boolean  @default(true) // false dès que l'étudiant choisit lui-même l'icône
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapters  Chapter[]
  documents Document[]
  exercises LegacyExercise[]
  sessions  Session[]

  // ── V2 ──
  folders        Folder[]
  concepts       Concept[]
  notes          Note[]
  mindMaps       MindMap[]
  studyExercises Exercise[]
  activities     LearningActivity[]
  learningRecs   LearningRecommendation[]
  labWorkspaces  LabWorkspace[]
  conversations  Conversation[]
  scheduleEvents ScheduleEvent[]
  academicTasks  AcademicTask[]

  @@index([userId])
}

model Chapter {
  id          String   @id @default(cuid())
  subjectId   String
  name        String
  description String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  documents Document[]

  @@index([subjectId])
}

model Document {
  id            String   @id @default(cuid())
  userId        String
  subjectId     String?
  chapterId     String?
  name          String
  originalName  String
  type          String // pdf | docx | txt | md | pptx
  size          Int
  status        String   @default("PENDING") // PENDING | PROCESSING | READY | ERROR
  extractedText String?
  pageCount     Int?
  meta          String? // JSON : sections, tableaux, code, avertissements
  error         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject  Subject?                 @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  chapter  Chapter?                 @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  chunks   LegacyDocumentChunk[]
  analyses LegacyDocumentAnalysis[]

  // ── V2 ──
  folderId         String?
  currentVersionId String?           @unique
  lastOpenedAt     DateTime?
  lastPage         Int?
  folder           Folder?           @relation(fields: [folderId], references: [id], onDelete: SetNull)
  currentVersion   DocumentVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions         DocumentVersion[] @relation("DocumentVersions")
  noteLinks        NoteLink[]
  studyExercises   Exercise[]
  conversations    Conversation[]
  academicTasks    AcademicTask[]

  @@index([userId, lastOpenedAt])
  @@index([subjectId])
  @@index([status])
  @@index([folderId])
}

model LegacyDocumentChunk {
  id         String  @id @default(cuid())
  documentId String
  idx        Int
  section    String? // titre de section / page d'origine
  content    String
  words      Int     @default(0)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("LegacyDocumentChunk")
}

model LegacyDocumentAnalysis {
  id            String   @id @default(cuid())
  documentId    String   @unique
  summary       String?
  subjectGuess  String?
  chapters      String? // JSON
  notions       String? // JSON
  definitions   String? // JSON
  methods       String? // JSON
  formulas      String? // JSON
  codeExcerpts  String? // JSON
  pitfalls      String? // JSON
  prerequisites String? // JSON
  evaluable     String? // JSON
  relations     String? // JSON
  raw           String? // JSON brut de l'IA
  model         String?
  createdAt     DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("LegacyDocumentAnalysis")
}

// ─────────────────────────── Exercices & sessions ───────────────────────────

model LegacyExercise {
  id        String   @id @default(cuid())
  userId    String
  subjectId String?
  title     String
  config    String // JSON : difficulté, types, thèmes, documents sources
  questions String // JSON : tableau de questions typées
  status    String   @default("READY") // READY | USED | ARCHIVED
  createdAt DateTime @default(now())

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  items   SessionItem[]

  @@index([userId])
  @@index([subjectId])
  @@map("LegacyExercise")
}

model Session {
  id          String    @id @default(cuid())
  userId      String
  subjectId   String?
  title       String    @default("Session d'exercices")
  mode        String    @default("apprentissage") // apprentissage | entrainement | examen | revision | personnalise
  status      String    @default("IN_PROGRESS") // IN_PROGRESS | SUBMITTED | GRADED
  config      String? // JSON : configuration de génération
  questions   String // JSON : questions au moment de la session (copie figée)
  hintsUsed   Int       @default(0)
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  durationSec Int?
  score       Float?
  maxScore    Float?
  percentage  Float?
  summary     String? // JSON : compte rendu final

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  items   SessionItem[]

  @@index([userId])
  @@index([subjectId])
  @@index([status])
}

model SessionItem {
  id          String  @id @default(cuid())
  sessionId   String
  exerciseId  String?
  questionIdx Int
  maxPoints   Float   @default(1)
  points      Float?
  status      String  @default("PENDING") // PENDING | CORRECT | PARTIAL | INCORRECT | SKIPPED
  graded      Boolean @default(false)
  hintsUsed   Int     @default(0) // indices révélés pour CETTE question

  session  Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise LegacyExercise? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  answers  LegacyAnswer[]

  @@index([sessionId])
}

model LegacyAnswer {
  id        String   @id @default(cuid())
  itemId    String
  value     String // JSON : réponse de l'utilisateur
  feedback  String? // JSON : correction détaillée (critères, explication, sources)
  gradedBy  String? // rule | ai | mixed
  attempts  Int      @default(1)
  createdAt DateTime @default(now())

  item SessionItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("LegacyAnswer")
}

// ─────────────────────────── Suivi des notions & révision ───────────────────────────

model ConceptStat {
  id       String   @id @default(cuid())
  userId   String
  notion   String
  attempts Int      @default(0)
  correct  Int      @default(0)
  partial  Int      @default(0)
  mastery  Float    @default(0) // 0..1
  lastSeen DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, notion])
  @@index([userId])
}

model StudyRecommendation {
  id        String   @id @default(cuid())
  userId    String
  notion    String
  reason    String
  priority  Float    @default(0.5)
  status    String   @default("OPEN") // OPEN | ACCEPTED | DISMISSED
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────── Exécution de code & SQL ───────────────────────────

model ProgramRun {
  id         String   @id @default(cuid())
  userId     String
  sessionId  String?
  language   String
  code       String
  stdout     String?
  stderr     String?
  exitCode   Int?
  durationMs Int?
  ok         Boolean  @default(false)
  limited    String? // raison de la limitation éventuelle
  createdAt  DateTime @default(now())

  @@index([userId])
}

model SqlQueryLog {
  id         String   @id @default(cuid())
  userId     String
  sessionId  String?
  sql        String
  ok         Boolean  @default(false)
  rowCount   Int?
  error      String?
  durationMs Int?
  createdAt  DateTime @default(now())

  @@index([userId])
}

// ─────────────────────────── Chat documentaire ───────────────────────────

model ChatMessage {
  id         String   @id @default(cuid())
  userId     String
  documentId String
  role       String // user | assistant
  content    String
  sources    String? // JSON : [{ document, section }]
  createdAt  DateTime @default(now())

  @@index([userId, documentId, createdAt])
}

// ─────────────────────────── Journalisation IA ───────────────────────────

model AIUsageLog {
  id          String   @id @default(cuid())
  userId      String?
  op          String // analysis | rag | generation | grading | explain | revision
  model       String?
  promptChars Int?
  respChars   Int?
  ok          Boolean  @default(true)
  error       String?
  durationMs  Int?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([op])
}

// ═════════════════════════════════════════════════════════════════════════════
//                              NIALA V2
// Principes : chaque table porte un userId (isolation + RLS) ; le JSON n'est
// utilisé que pour des contenus validés par zod côté serveur ; les fichiers
// originaux vivent dans le stockage objet (DocumentVersion.storageKey), le texte
// extrait n'est qu'un index dérivé.
// ═════════════════════════════════════════════════════════════════════════════

enum ExtractStatus {
  PENDING
  PROCESSING
  READY
  PARTIAL // texte extrait avec avertissements (pages scannées…)
  FAILED
  UNSUPPORTED // pas d'extraction possible, le fichier reste consultable/téléchargeable
}

enum AnalysisStatus {
  PENDING
  RUNNING
  READY
  FAILED
}

enum Origin {
  DOCUMENT // explicitement présent dans le document
  AI_INFERRED // déduit par l'IA
  USER // ajouté ou corrigé par l'étudiant
}

enum ConceptKind {
  NOTION
  DEFINITION
  PROPERTY
  RULE
  EXAMPLE
}

enum RelationType {
  PREREQUISITE
  PART_OF
  EXAMPLE_OF
  DEFINES
  CONTRASTS
  RELATED
}

enum NoteKind {
  PERSONAL
  DOCUMENT
  ANNOTATION
  SUMMARY
}

enum MapKind {
  STRUCTURE
  CONCEPT
}

enum ExerciseStatus {
  READY
  ARCHIVED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

enum GradedBy {
  RULE
  TEST
  AI
  MIXED
}

enum ErrorCategory {
  SYNTAX
  LOGIC
  CONCEPT
  METHOD
  INSTRUCTION
  FORGETTING
  CARELESS
}

enum ActivityStatus {
  SUGGESTED
  IN_PROGRESS
  DONE
  DISMISSED
}

enum LabKind {
  CODE
  SQL
}

enum LabMode {
  FREE
  EXERCISE
}

// ─────────────────────────── Dossiers & versions ───────────────────────────

/// Dossier libre de l'étudiant (récursif). Distinct de la structure pédagogique détectée par l'IA.
/// NB : @@unique ne protège pas les noms à la racine (parentId NULL en SQL) → contrôlé en transaction par le service.
model Folder {
  id        String   @id @default(cuid())
  userId    String
  subjectId String
  parentId  String?
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  parent    Folder?    @relation("FolderTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Folder[]   @relation("FolderTree")
  documents Document[]

  @@unique([subjectId, parentId, name])
  @@index([userId])
  @@index([subjectId, parentId])
}

/// Version immuable d'un fichier : le fichier original (stockage objet) + son extraction.
model DocumentVersion {
  id              String        @id @default(cuid())
  userId          String
  documentId      String
  number          Int
  storageKey      String? // null tant que l'original n'est pas (ré)importé
  originalMissing Boolean       @default(false) // données migrées de la V1 : original jamais conservé
  mime            String
  size            Int
  sha256          String?
  pageCount       Int?
  extractStatus   ExtractStatus @default(PENDING)
  extractError    String?
  extractWarnings Json? // string[]
  createdAt       DateTime      @default(now())

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  document  Document           @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  currentOf Document?          @relation("CurrentVersion")
  chunks    DocumentChunk[]
  analyses  DocumentAnalysis[]
  noteLinks NoteLink[]
  exercises Exercise[]

  @@unique([documentId, number])
  @@index([userId])
  @@index([sha256])
}

/// Texte extrait et indexé (jamais affiché à la place du document). Conserve page et offsets pour citer.
model DocumentChunk {
  id        String @id @default(cuid())
  userId    String
  versionId String
  idx       Int
  page      Int?
  charStart Int    @default(0)
  charEnd   Int    @default(0)
  content   String
  words     Int    @default(0)
  /// Vecteur sémantique (Gemini, normalisé). Vide tant que le passage n'est pas encore indexé.
  embedding      Float[] @default([])
  embeddingModel String?

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  version DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, idx])
  @@index([userId])
}

// ─────────────────────────── Analyse pédagogique ───────────────────────────

/// Une analyse est liée à UNE version ; relancer crée une nouvelle ligne (historique conservé).
model DocumentAnalysis {
  id            String         @id @default(cuid())
  userId        String
  versionId     String
  status        AnalysisStatus @default(PENDING)
  model         String?
  promptVersion String?
  summary       String?
  error         String?
  createdAt     DateTime       @default(now())
  finishedAt    DateTime?

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  version  DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  sections CourseSection[]
  sources  ConceptSource[]
  maps     MindMap[]

  @@index([userId])
  @@index([versionId, createdAt])
}

/// Plan hiérarchique du document (CHAPITRE II > I > A > 1 > a …), fidèle à la numérotation d'origine.
model CourseSection {
  id         String  @id @default(cuid())
  userId     String
  analysisId String
  parentId   String?
  label      String // titre, éditable
  numbering  String? // "II", "A", "3", "b"… tel qu'écrit dans le document
  level      Int     @default(0)
  position   Int     @default(0)
  pageStart  Int?
  pageEnd    Int?
  origin     Origin  @default(DOCUMENT)
  edited     Boolean @default(false)
  refs       Json? // SourceRef[] : [{ chunkId, page, quote }]

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis DocumentAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  parent   CourseSection?   @relation("SectionTree", fields: [parentId], references: [id], onDelete: Cascade)
  children CourseSection[]  @relation("SectionTree")
  sources  ConceptSource[]
  nodes    MindMapNode[]

  @@index([userId])
  @@index([analysisId, parentId, position])
}

/// Identité d'une notion DANS UNE MATIÈRE (jamais fusionnée entre matières).
model Concept {
  id             String      @id @default(cuid())
  userId         String
  subjectId      String
  name           String
  normalizedName String
  kind           ConceptKind @default(NOTION)
  importance     Int         @default(2) // 1 secondaire · 2 normale · 3 principale
  createdAt      DateTime    @default(now())

  user      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   Subject                  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  sources   ConceptSource[]
  outgoing  ConceptRelation[]        @relation("RelationFrom")
  incoming  ConceptRelation[]        @relation("RelationTo")
  questions QuestionConcept[]
  mastery   ConceptMastery?
  diagnoses ErrorDiagnosis[]
  nodes     MindMapNode[]
  recs      LearningRecommendation[]

  @@unique([subjectId, normalizedName, kind])
  @@index([userId])
}

/// Provenance d'une notion : où, dans quelle analyse, et si elle est écrite ou déduite.
model ConceptSource {
  id         String  @id @default(cuid())
  userId     String
  conceptId  String
  analysisId String
  sectionId  String?
  origin     Origin  @default(DOCUMENT)
  definition String?
  refs       Json? // SourceRef[]

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept  Concept          @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  analysis DocumentAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  section  CourseSection?   @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@unique([conceptId, analysisId, sectionId])
  @@index([userId])
}

model ConceptRelation {
  id        String       @id @default(cuid())
  userId    String
  subjectId String
  fromId    String
  toId      String
  type      RelationType @default(RELATED)
  origin    Origin       @default(AI_INFERRED)
  refs      Json?

  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  from Concept @relation("RelationFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   Concept @relation("RelationTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, type])
  @@index([userId])
  @@index([subjectId])
}

// ─────────────────────────── Notes unifiées ───────────────────────────

/// Un seul système : personnelle, liée à un document, annotation de passage ou fiche de synthèse.
model Note {
  id        String   @id @default(cuid())
  userId    String
  subjectId String
  kind      NoteKind @default(PERSONAL)
  title     String   @default("")
  content   Json // document de l'éditeur riche
  revision  Int      @default(1) // contrôle de concurrence optimiste
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  links   NoteLink[]

  @@index([userId])
  @@index([subjectId, kind, updatedAt])
}

/// Référence N:N d'une note vers des documents ; porte l'ancrage précis d'une annotation.
model NoteLink {
  id         String  @id @default(cuid())
  userId     String
  noteId     String
  documentId String
  versionId  String?
  page       Int?
  anchor     Json? // { quote, charStart, charEnd, rects[] }

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  note     Note             @relation(fields: [noteId], references: [id], onDelete: Cascade)
  document Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version  DocumentVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([noteId])
  @@index([documentId, page])
}

// ─────────────────────────── Cartes (graphes éditables) ───────────────────────────

model MindMap {
  id         String   @id @default(cuid())
  userId     String
  subjectId  String
  analysisId String?
  kind       MapKind
  title      String
  revision   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  analysis  DocumentAnalysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  nodes     MindMapNode[]
  edges     MindMapEdge[]
  revisions MindMapRevision[]

  @@index([userId])
  @@index([subjectId])
}

model MindMapNode {
  id        String  @id @default(cuid())
  userId    String
  mapId     String
  label     String
  x         Float   @default(0)
  y         Float   @default(0)
  origin    Origin  @default(AI_INFERRED)
  conceptId String?
  sectionId String?
  data      Json?

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  map     MindMap        @relation(fields: [mapId], references: [id], onDelete: Cascade)
  concept Concept?       @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  section CourseSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  out     MindMapEdge[]  @relation("EdgeSource")
  in      MindMapEdge[]  @relation("EdgeTarget")

  @@index([userId])
  @@index([mapId])
}

model MindMapEdge {
  id       String       @id @default(cuid())
  userId   String
  mapId    String
  sourceId String
  targetId String
  type     RelationType @default(RELATED)
  label    String?
  origin   Origin       @default(AI_INFERRED)

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  map    MindMap     @relation(fields: [mapId], references: [id], onDelete: Cascade)
  source MindMapNode @relation("EdgeSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target MindMapNode @relation("EdgeTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([mapId])
}

model MindMapRevision {
  id        String   @id @default(cuid())
  userId    String
  mapId     String
  number    Int
  snapshot  Json
  createdAt DateTime @default(now())

  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  map  MindMap @relation(fields: [mapId], references: [id], onDelete: Cascade)

  @@unique([mapId, number])
  @@index([userId])
}

// ─────────────────────────── Exercices & tentatives ───────────────────────────

/// Exercice indépendant du document source (référence conservée, SetNull si supprimé).
model Exercise {
  id          String         @id @default(cuid())
  userId      String
  subjectId   String? // null : exercice libre ou importé, sans matière enregistrée
  documentId  String?
  versionId   String?
  title       String
  config      Json // nombre, barème, types, couverture, difficulté (validé par zod)
  totalPoints Float
  status      ExerciseStatus @default(READY)
  origin      String         @default("DOCUMENT") // DOCUMENT | FREE | IMPORTED
  saved       Boolean        @default(true) // false : exercice ponctuel, absent de « Mes exercices » et purgé ensuite
  createdAt   DateTime       @default(now())

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   Subject?          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  document  Document?         @relation(fields: [documentId], references: [id], onDelete: SetNull)
  version   DocumentVersion?  @relation(fields: [versionId], references: [id], onDelete: SetNull)
  questions Question[]
  attempts  ExerciseAttempt[]
  labs      LabWorkspace[]
  academicTasks AcademicTask[]

  @@index([userId, saved, createdAt])
  @@index([subjectId, createdAt])
}

model Question {
  id          String  @id @default(cuid())
  userId      String
  exerciseId  String
  position    Int
  type        String // QuestionType (voir lib/types.ts), évolutif
  points      Float
  difficulty  String
  payload     Json // énoncé, options, trous, tests…
  answerKey   Json // jamais renvoyé au client avant correction
  explanation String?
  sourceRefs  Json? // SourceRef[]

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise          @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  concepts QuestionConcept[]

  @@unique([exerciseId, position])
  @@index([userId])
}

model QuestionConcept {
  questionId String
  conceptId  String

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  concept  Concept  @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@id([questionId, conceptId])
  @@index([conceptId])
}

model ExerciseAttempt {
  id           String        @id @default(cuid())
  userId       String
  exerciseId   String?
  snapshot     Json // copie figée des questions au démarrage
  status       AttemptStatus @default(IN_PROGRESS)
  startedAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  finishedAt   DateTime?
  lastPosition Int           @default(0) // reprise
  durationSec  Int?
  score        Float?
  maxScore     Float?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  answers  Answer[]
  tutorMessages AttemptTutorMessage[]

  @@index([userId, status, finishedAt])
  @@index([exerciseId])
}

/// Échanges avec le tuteur pendant une tentative, question par question : reprise et contexte des réponses suivantes.
model AttemptTutorMessage {
  id        String   @id @default(cuid())
  userId    String
  attemptId String
  position  Int
  role      ChatRole
  kind      String // hint | explain | clarify | why_wrong | correction | steps | free
  content   String
  createdAt DateTime @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempt ExerciseAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId, position, createdAt])
  @@index([userId])
}

model Answer {
  id        String    @id @default(cuid())
  userId    String
  attemptId String
  position  Int
  value     Json
  feedback  Json?
  verdict   String? // correct | partial | incorrect | skipped
  points    Float?
  gradedBy  GradedBy?
  tries     Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempt   ExerciseAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  diagnoses ErrorDiagnosis[]

  @@unique([attemptId, position])
  @@index([userId])
}

// ─────────────────────────── Apprentissage adaptatif ───────────────────────────

/// Diagnostic justifié : la catégorie ET les preuves qui l'appuient.
model ErrorDiagnosis {
  id         String        @id @default(cuid())
  userId     String
  answerId   String?
  labRunId   String?
  conceptId  String?
  category   ErrorCategory
  confidence Float // 0..1
  evidence   Json // éléments de justification
  createdAt  DateTime      @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answer  Answer?  @relation(fields: [answerId], references: [id], onDelete: SetNull)
  labRun  LabRun?  @relation(fields: [labRunId], references: [id], onDelete: SetNull)
  concept Concept? @relation(fields: [conceptId], references: [id], onDelete: SetNull)

  @@index([userId, conceptId])
}

/// Estimation de maîtrise recalculable à partir des preuves (réponses, diagnostics), avec niveau de confiance.
model ConceptMastery {
  conceptId      String    @id
  userId         String
  level          Float     @default(0) // 0..1
  confidence     Float     @default(0) // 0..1 : fiabilité de l'estimation
  evidenceCount  Int       @default(0)
  lastEvidenceAt DateTime?
  updatedAt      DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Dernière activité / activités en cours : sert à la reprise et au tableau de bord.
model LearningActivity {
  id           String         @id @default(cuid())
  userId       String
  subjectId    String?
  type         String // READING | EXERCISE | LAB_CODE | LAB_SQL | REVISION
  refType      String?
  refId        String?
  title        String
  status       ActivityStatus @default(IN_PROGRESS)
  lastPosition Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId, status, updatedAt])
}

model LearningRecommendation {
  id           String         @id @default(cuid())
  userId       String
  subjectId    String?
  conceptId    String?
  activityType String
  reason       Json // explication lisible + preuves
  status       ActivityStatus @default(SUGGESTED)
  createdAt    DateTime       @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  concept Concept? @relation(fields: [conceptId], references: [id], onDelete: SetNull)

  @@index([userId, status])
}

// ─────────────────────────── Laboratoires ───────────────────────────

model LabWorkspace {
  id         String   @id @default(cuid())
  userId     String
  subjectId  String?
  exerciseId String?
  kind       LabKind
  mode       LabMode  @default(FREE)
  title      String
  files      Json // { name, language, content }[]
  brief      Json? // consignes extraites d'un document importé
  schemaSql  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject  Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  exercise Exercise? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  runs     LabRun[]

  @@index([userId, kind, updatedAt])
}

model LabRun {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  input       Json
  output      Json
  tests       Json? // résultats des tests objectifs
  evaluation  Json? // évaluation IA (après les tests)
  createdAt   DateTime @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace LabWorkspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  diagnoses ErrorDiagnosis[]

  @@index([userId, createdAt])
  @@index([workspaceId, createdAt])
}

// ─────────────────────────── Conversations avec l'IA ───────────────────────────

enum ConversationScope {
  GLOBAL // toute la bibliothèque (ou une matière)
  DOCUMENT // un seul cours : la conversation ne voit jamais les autres documents
}

enum ChatRole {
  USER
  ASSISTANT
}

model Conversation {
  id         String            @id @default(cuid())
  userId     String
  scope      ConversationScope
  documentId String?
  subjectId  String?
  title      String
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  document Document?             @relation(fields: [documentId], references: [id], onDelete: Cascade)
  subject  Subject?              @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  messages ConversationMessage[]

  @@index([userId, scope, updatedAt])
  @@index([documentId])
}

model ConversationMessage {
  id             String   @id @default(cuid())
  userId         String
  conversationId String
  role           ChatRole
  content        String
  /// Références réellement retrouvées dans les documents : [{ n, documentId, documentName, versionId, page, section, quote }]
  citations      Json?
  /// Ce que l'IA a consulté : { documents, passages, pages, coverage, warnings }
  consulted      Json?
  model          String?
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/// Une vérification de fiabilité (une réponse du chat, par exemple) et ses limites.
model VerificationRun {
  id                String   @id @default(cuid())
  userId            String
  feature           String
  entityType        String
  entityId          String
  status            String
  webStatus         String
  summary           Json
  limits            Json
  rejectedCitations Int      @default(0)
  checkedAt         DateTime @default(now())

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sources SourceSnapshot[]
  claims  Claim[]

  @@index([userId, feature])
  @@index([entityType, entityId])
}

/// Source telle que consultée au moment de la vérification.
model SourceSnapshot {
  id           String   @id @default(cuid())
  runId        String
  n            Int
  kind         String
  title        String
  url          String?
  host         String?
  organization String?
  documentId   String?
  page         Int?
  level        Int?
  sourceKind   String?
  publishedAt  String?
  excerpt      String
  retrievedAt  DateTime @default(now())

  run      VerificationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  evidence ClaimEvidence[]

  @@index([runId])
}

/// Affirmation extraite d'une réponse et niveau de confiance calculé par le serveur.
model Claim {
  id             String  @id @default(cuid())
  runId          String
  text           String
  claimType      String
  domain         String
  confidence     String
  basis          String
  reason         String?
  limits         Json
  courseConflict Boolean @default(false)

  run      VerificationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  evidence ClaimEvidence[]

  @@index([runId])
}

/// Passage d'une source qui soutient ou contredit une affirmation (existence contrôlée par le serveur).
model ClaimEvidence {
  id       String  @id @default(cuid())
  claimId  String
  sourceId String
  stance   String
  quote    String
  direct   Boolean @default(true)

  claim  Claim          @relation(fields: [claimId], references: [id], onDelete: Cascade)
  source SourceSnapshot @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@index([sourceId])
}

/// Cours ou événement de l'emploi du temps. Date « AAAA-MM-JJ » et minutes depuis minuit : heure locale de l'établissement.
model ScheduleEvent {
  id           String    @id @default(cuid())
  userId       String
  subjectId    String?
  importId     String?
  title        String
  kind         String    @default("COURSE") // COURSE | REVISION | EVENT
  date         String // première séance
  startMinutes Int
  endMinutes   Int
  recurrence   String    @default("NONE") // NONE | WEEKLY | DATES
  dates        Json? // liste explicite des séances (semaines précises d'un emploi du temps)
  endDate      String? // fin d'une période sur plusieurs jours (congés, examens)
  allDay       Boolean   @default(false)
  code         String? // code de la matière dans le document
  sessionType  String? // CM | TD | TP | …
  until        String?
  weekPattern  String    @default("ALL") // ALL | A | B
  room         String?
  teacher      String?
  groupName    String?
  description  String?
  confidence   String? // niveau de confiance de l'extraction, pour un cours importé
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   Subject?           @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  import    ScheduleImport?    @relation(fields: [importId], references: [id], onDelete: SetNull)
  overrides ScheduleOverride[]

  @@index([userId, date])
  @@index([importId])
}

/// Modification ou annulation d'une seule séance d'une série.
model ScheduleOverride {
  id           String  @id @default(cuid())
  eventId      String
  date         String // date d'origine de la séance
  cancelled    Boolean @default(false)
  newDate      String?
  startMinutes Int?
  endMinutes   Int?
  subjectId    String?
  title        String?
  room         String?
  teacher      String?
  description  String?

  event ScheduleEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, date])
}

/// Import d'un emploi du temps : fichier d'origine et brouillon soumis à la validation de l'étudiant.
model ScheduleImport {
  id          String    @id @default(cuid())
  userId      String
  fileName    String
  mime        String
  size        Int
  sha256      String
  storageKey  String
  status      String    @default("REVIEW") // REVIEW | CONFIRMED
  draft       Json
  warnings    Json
  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  events ScheduleEvent[]
  breaks ScheduleBreak[]

  @@index([userId, createdAt])
}

/// Pause d'un emploi du temps : extraite d'un document ou saisie par l'étudiant, jamais imposée.
model ScheduleBreak {
  id           String          @id @default(cuid())
  userId       String
  importId     String?
  label        String          @default("Pause")
  startMinutes Int
  endMinutes   Int
  weekday      Int? // null : tous les jours

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  import ScheduleImport? @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Échéance de l'agenda académique personnel (devoir, TD à rendre, projet, révision…).
model AcademicTask {
  id                 String    @id @default(cuid())
  userId             String
  subjectId          String?
  documentId         String?
  exerciseId         String?
  parentId           String? // étape intermédiaire d'un projet
  title              String
  description        String?
  type               String    @default("DEVOIR")
  priority           String    @default("NORMALE") // BASSE | NORMALE | HAUTE
  status             String    @default("A_COMMENCER")
  dueDate            String
  dueMinutes         Int?
  estimatedMinutes   Int?
  requiresSubmission Boolean   @default(false)
  reminderMinutes    Json? // minutes avant l'échéance
  recurrence         String    @default("NONE") // NONE | WEEKLY
  completedAt        DateTime?
  submittedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject  Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  document Document?      @relation(fields: [documentId], references: [id], onDelete: SetNull)
  exercise Exercise?      @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  parent   AcademicTask?  @relation("TaskSteps", fields: [parentId], references: [id], onDelete: Cascade)
  steps    AcademicTask[] @relation("TaskSteps")
  sessions StudySession[]

  @@index([userId, dueDate])
}

/// Séance de travail acceptée par l'étudiant pour une échéance.
model StudySession {
  id           String       @id @default(cuid())
  userId       String
  taskId       String
  date         String
  startMinutes Int
  endMinutes   Int
  done         Boolean      @default(false)

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  task AcademicTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

// ═════════════════════════════════════════════════════════════════════════════
//                    BACK-OFFICE ADMINISTRATEUR (voir docs/ADMIN.md)
// Les événements d'analyse ne portent AUCUNE clé étrangère vers User : l'utilisateur y est
// pseudonymisé (HMAC) et la suppression d'un compte n'efface pas les statistiques agrégées.
// ═════════════════════════════════════════════════════════════════════════════

/// Événement d'usage. Contient un type, un module et de petites métadonnées techniques : jamais de contenu de travail.
model AnalyticsEvent {
  id         String   @id @default(cuid())
  type       String // voir server/analytics/definitions.ts
  module     String?
  actorKey   String // pseudonyme HMAC de l'utilisateur
  category   String? // catégorie du profil au moment de l'événement (ESATIC | OTHER_SCHOOL | TESTER)
  source     String   @default("LIVE") // LIVE : collecté en direct | BACKFILL : reconstitué depuis les tables d'origine
  sourceRef  String? // identifiant de la ligne d'origine d'un événement reconstitué (évite les doublons)
  ok         Boolean  @default(true)
  durationMs Int?
  props      Json?
  createdAt  DateTime @default(now())

  @@unique([type, sourceRef])
  @@index([createdAt])
  @@index([type, createdAt])
  @@index([actorKey, createdAt])
}

/// Une ligne par requête d'API : temps de réponse, statut et classe d'erreur (jamais le contenu de la requête).
model RequestLog {
  id           String   @id @default(cuid())
  route        String
  method       String
  status       Int
  durationMs   Int
  module       String?
  errorKind    String? // USER | APP | EXTERNAL
  errorSummary String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([route, createdAt])
  @@index([errorKind, createdAt])
}

model SupportRequest {
  id            String    @id @default(cuid())
  reference     String    @unique // NL-AAMM-NNNN, communiquée à l'utilisateur
  userId        String
  type          String // IMPROVEMENT | FEATURE | BUG | EXERCISE_DIFFICULTY | AI_ISSUE | ASSISTANCE | OTHER
  subject       String
  description   String
  module        String?
  urgency       String? // LOW | NORMAL | HIGH : urgence indiquée par l'utilisateur (facultative)
  priority      String    @default("NORMAL") // LOW | NORMAL | HIGH | URGENT : fixée par l'équipe
  status        String    @default("RECEIVED") // RECEIVED | PENDING_REVIEW | IN_PROGRESS | NEEDS_INFO | RESOLVED | REJECTED
  assigneeId    String?
  roadmapItemId String?
  attachments   Json? // [{ key, name, mime, size }] dans le stockage privé
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  firstReplyAt  DateTime?
  closedAt      DateTime?

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapItem RoadmapItem?     @relation(fields: [roadmapItemId], references: [id], onDelete: SetNull)
  messages    SupportMessage[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([roadmapItemId])
}

model SupportMessage {
  id         String   @id @default(cuid())
  requestId  String
  authorId   String?
  authorRole String // USER | ADMIN
  authorName String?
  internal   Boolean  @default(false) // note interne : jamais renvoyée à l'utilisateur
  body       String
  createdAt  DateTime @default(now())

  request SupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

/// Besoin récurrent regroupant plusieurs demandes, avec son statut de feuille de route.
model RoadmapItem {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("TO_STUDY") // TO_STUDY | PLANNED | IN_DEV | DEPLOYED | REJECTED
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requests SupportRequest[]

  @@index([status])
}

/// Journal d'audit des actions du back-office. Ajout seul : un déclencheur SQL refuse toute modification ou suppression.
model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String
  targetType String?
  targetId   String?
  result     String   @default("SUCCESS") // SUCCESS | DENIED | FAILED
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model AdminSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

/// Alerte ou incident détecté par la supervision (taux d'erreurs, IA…). Une seule alerte ouverte par clé.
model AdminAlert {
  id         String    @id @default(cuid())
  key        String // identifie la règle ayant déclenché l'alerte, ex. « errors.rate »
  severity   String // WARNING | CRITICAL
  title      String
  detail     String?
  status     String    @default("OPEN") // OPEN | RESOLVED
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([status, createdAt])
  @@index([key, status])
}

model Announcement {
  id             String   @id @default(cuid())
  kind           String // INFO | FEATURE | MAINTENANCE | ALERT
  title          String
  body           String
  audience       Json // { categories?: string[], levels?: string[], institutions?: string[] } ; objet vide = tous les comptes actifs
  recipientCount Int
  createdById    String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

/// Notification affichée à l'étudiant dans Niala (annonce, réponse à une demande, changement de statut).
model UserNotification {
  id        String    @id @default(cuid())
  userId    String
  kind      String // ANNOUNCEMENT | REQUEST_UPDATE | REQUEST_REPLY
  title     String
  body      String?
  link      String?
  refId     String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}
